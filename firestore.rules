rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(tenantId, uid) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(uid));
    }

    function myRole(tenantId) {
      return memberDoc(tenantId, request.auth.uid).data.role;
    }

    // An owner or admin must also be an ACTIVE member: a suspended admin keeps no admin powers.
    function isOwner(tenantId) {
      return isMember(tenantId) && myRole(tenantId) == 'owner';
    }

    function isAdmin(tenantId) {
      return isMember(tenantId) && myRole(tenantId) == 'admin';
    }

    function isOwnerOrAdmin(tenantId) {
      return isOwner(tenantId) || isAdmin(tenantId);
    }

    // True only when the member doc says status == 'active'. No legacy tolerance (S2f-6): every member
    // doc is created with a status and dev has no legacy data. The gateway (functions/index.js
    // deriveContext) applies the same rule and the two must not drift (Skills 127, 128). A missing
    // status makes this expression error, which denies.
    function memberStatusIsActive(tenantId, uid) {
      return memberDoc(tenantId, uid).data.status == 'active';
    }

    // "Member" means ACTIVE member WITH A VALID ROLE everywhere in this file (S2f-2). Before, it was
    // exists() only, so a suspended member kept direct Firestore read and write access that the gateway
    // already refused. The role test mirrors deriveContext's VALID_ROLES (functions/index.js): a member doc
    // whose role is "", "viewer", "Owner", a number or missing must not pass in one enforcer and fail in
    // the other. Adding a role means editing roleIsValid AND VALID_ROLES (Skill 128 rule 10).
    function isMember(tenantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && memberStatusIsActive(tenantId, request.auth.uid)
        && roleIsValid(myRole(tenantId));
    }

    // Which roles an actor may hand out. Mirrors canAssignRole in functions/index.js and
    // AuthService._canAssignRole: an owner assigns admin/manager/staff, an admin assigns
    // manager/staff, nobody assigns owner (the only owner is the one the tenant bootstrap creates).
    function canAssignRole(tenantId, role) {
      return (isOwner(tenantId) && role in ['admin', 'manager', 'staff'])
        || (isAdmin(tenantId) && role in ['manager', 'staff']);
    }

    function roleIsValid(role) {
      return role in ['owner', 'admin', 'manager', 'staff'];
    }

    function statusIsValid(status) {
      return status in ['active', 'suspended'];
    }

    // Ledger tier (P0): immutable, append-only, written ONLY by the
    // compliance gateway Cloud Function via the Admin SDK (which bypasses
    // these rules). Clients may read for display but may never write —
    // this is what an MCA Rule 11(g) auditor tests for.
    function isLedgerCollection(name) {
      return name in ['audit_log', 'transactions', 'stock_batches', 'stock_movements'];
    }

    // Server-only tier: unlike the ledger collections above (readable for
    // display, write-locked), clients have no legitimate reason to touch
    // this collection AT ALL, not even to read — every access goes through
    // LockManager -> the acquireLock/releaseLock Cloud Functions, which use
    // the Admin SDK and bypass these rules entirely. NOTE: the generic
    // fallback's `allow read` below is not gated by isLedgerCollection, so
    // adding a name to isLedgerCollection alone would NOT block reads —
    // Firestore grants a request if ANY matching rule allows it, so the
    // fallback's read rule has to carve this out explicitly too.
    function isServerOnlyCollection(name) {
      // 'pending_cleanup' (PH3, 2026-10-03): product-photo cleanup markers, written and removed only by
      // the recordMutation Cloud Function (Admin SDK). A member who could forge or erase one could
      // either leave photos orphaned or stop a pending sweep. Listing the name HERE (not just adding
      // a deny-all match block) is what actually denies: the wildcard below would still allow it.
      return name in ['locks', 'pending_cleanup'];
    }

    // Gateway-write-only tier (P1 S2c): clients may READ these for display but
    // may never create, update or delete. Every write goes through the gateway
    // Cloud Functions (recordMutation / recordDelta / recordOperation, Admin
    // SDK), which is what writes the audit_log and stock ledger rows; a direct
    // client write would change stock with no ledger trail. Same trap as the
    // two tiers above: a lone `match /inventory/{id} { allow write: if false }`
    // would NOT deny, because the wildcard below still allows and Firestore
    // grants a request if ANY matching rule allows it. The name must be listed
    // HERE so the wildcard's write guard excludes it. Reads stay on the
    // wildcard. Exact collection names only.
    function isGatewayWriteOnlyCollection(name) {
      return name in ['inventory'];
    }

    // Access-control tier (S2f-2): collections whose documents decide who may do what. They have their
    // own explicit match block below, and Firestore ORs every matching rule, so the wildcard at the
    // bottom would otherwise let ANY member write them (a staff token could promote itself to owner,
    // proven by probe PR #157). Naming a collection HERE removes it from the wildcard's write guard,
    // so the explicit block is the only thing that decides. Reads stay on the explicit block.
    // Exact collection names only.
    function isAccessControlCollection(name) {
      return name in ['members'];
    }

    // users/{uid}
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // tenants/{tenantId}
    match /tenants/{tenantId} {
      allow read: if isMember(tenantId);

      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string;

      // ownerId is the key the bootstrap rule below trusts: if an owner could rewrite it, the new id could
      // create its own `owner` member doc and mint a second owner past canAssignRole. Immutable after create.
      allow update: if isOwner(tenantId)
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(tenantId);

      // tenants/{tenantId}/members/{uid}
      match /members/{uid} {
        // Active members read the roster. A member may always read ITS OWN doc, even when suspended
        // or inactive, so the app can learn why it was locked out instead of failing blind.
        // The own-doc check goes FIRST: when the member doc has no status, isMember errors, and a
        // true left operand settles the `||` without depending on how an error operand is treated.
        allow read: if (isSignedIn() && request.auth.uid == uid)
                    || isMember(tenantId);

        allow create: if canAssignRole(tenantId, request.resource.data.role)
                      && statusIsValid(request.resource.data.status)
                      && request.resource.data.uid == uid;

        // BOOTSTRAP: owner creates their own membership during tenant setup.
        allow create: if isSignedIn()
                      && request.auth.uid == uid
                      && request.resource.data.role == 'owner'
                      && request.resource.data.status == 'active'
                      && exists(/databases/$(database)/documents/tenants/$(tenantId))
                      && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid
                      && !exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(uid));

        // An existing owner doc is never modified; the new role must be one the actor may assign.
        // The uid field must keep matching the doc id (create pins it; the Team Members roster targets
        // actions by this field, so a rewritten uid would aim Remove/Suspend at another member).
        allow update: if canAssignRole(tenantId, request.resource.data.role)
                      && statusIsValid(request.resource.data.status)
                      && request.resource.data.uid == uid
                      && resource.data.role != 'owner';

        allow delete: if isOwnerOrAdmin(tenantId)
                      && resource.data.role != 'owner'
                      && uid != request.auth.uid;

        // VOLUNTARY LEAVE: a member may remove their OWN membership (also when suspended). The owner
        // cannot self-leave (would orphan the workspace) — that's blocked by
        // the role check, matching leaveCurrentTenant()'s client guard.
        allow delete: if isSignedIn()
                      && uid == request.auth.uid
                      && resource.data.role != 'owner';
      }

      // Ledger collections — read-only to every client. Only the gateway
      // Cloud Function (Admin SDK) writes these.
      match /audit_log/{docId} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }
      match /transactions/{docId} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }
      match /stock_batches/{docId} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }
      match /stock_movements/{docId} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }

      // Server-only: acquireLock/releaseLock (Cloud Functions, Admin SDK)
      // are the only things that ever touch this. No client read either —
      // see isServerOnlyCollection's comment for why that has to be
      // explicit and can't just ride on isLedgerCollection.
      match /locks/{lockId} {
        allow read, write: if false;
      }

      // Working-tier domain collections (orders, sales, staff, suppliers,
      // ...). inventory is gateway-write-only since S2c: members read it,
      // only the gateway writes it. orders, staff, suppliers and
      // removed_staff are still client-writable here; locking them is a
      // separate follow-up (S2f-4). The access-control guard keeps `members` out of the writable
      // fallback (S2f-2). The ledger guard keeps a ledger collection from
      // ever matching this writable fallback, the gateway-write-only guard
      // does the same for inventory, and the server-only guard does it for
      // both read and write.
      match /{collection}/{docId} {
        allow read: if isMember(tenantId) && !isServerOnlyCollection(collection);
        allow create, update, delete: if isMember(tenantId)
                                      && !isLedgerCollection(collection)
                                      && !isGatewayWriteOnlyCollection(collection)
                                      && !isAccessControlCollection(collection)
                                      && !isServerOnlyCollection(collection);
      }
    }
  }
}
